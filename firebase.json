{
    "functions": [
        {
            "source": "functions",
            "codebase": "default",
            "ignore": ["node_modules", ".git", "firebase-debug.log", "*.local", "src", "lib/*.test.js"],
            "predeploy": ["npm --prefix \"$RESOURCE_DIR\" run build"]
        }
    ],
    "firestore": { "rules": "firestore.rules" },
    "emulators": {
        "functions": { "port": 5101 },
        "firestore": { "port": 8080 },
        "ui": { "enabled": false },
        "singleProjectMode": true
    }
}
