{
    "name": "dou-closer-word",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc --noEmit && vite build",
        "verify": "chatic-apps verify",
        "bundle": "chatic-apps bundle",
        "server": "npm --prefix functions run build && firebase emulators:start --only functions,firestore --project demo-closer-word",
        "deploy": "sh scripts/deploy.sh",
        "deploy:prod": "DEPLOY_ENV_FILE=.env.deploy.prod sh scripts/deploy.sh"
    },
    "dependencies": {
        "@lemoncloud/chatic-apps-sdk": "0.3.0"
    },
    "devDependencies": {
        "@lemoncloud/chatic-apps-devtools": "0.1.0",
        "typescript": "5.9.3",
        "vite": "7.3.0"
    }
}
